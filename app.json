{
  "expo": {
    "name": "Sigma Gadgets",
    "slug": "sigma-gadgets-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigmagadgets",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sigmagadgets.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sigmagadgets.app",
      "adaptiveIcon": {
        "backgroundColor": "#111317",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111317",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
